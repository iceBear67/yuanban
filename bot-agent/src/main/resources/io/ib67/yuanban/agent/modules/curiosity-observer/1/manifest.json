{
  "entry": "main",
  "description": "background，只读：每 intervalMs（默认 3000）观察 radius（默认 24）内的实体。第一次看到的玩家发出 interest(new_player)，8 格内的敌对生物发出 interest(hostile_nearby)，其余观察只写入 trace。rounds 给出时观察这么多轮后结束。",
  "inputSchema": {
    "type": ["object", "null"],
    "properties": {
      "intervalMs": {"type": "integer", "minimum": 200},
      "radius": {"type": "number", "minimum": 1, "maximum": 128},
      "rounds": {"type": "integer", "minimum": 1}
    }
  },
  "roles": ["background"],
  "messagesIn": ["stop", "focus", "policy"],
  "messagesOut": ["interest", "observation"],
  "capabilities": ["observe.*"],
  "fallback": "continue"
}
