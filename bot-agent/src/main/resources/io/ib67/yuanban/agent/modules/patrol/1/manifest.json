{
  "entry": "main",
  "description": "按顺序巡逻 points 中的路点 laps 圈（0 表示直到停止），路点之间等待 pauseMs。每个路点之后写检查点，重启时从检查点继续；到不了的路点发出 attention(unexpected_state)。返回 {kind: completed|stopped, laps, next}。",
  "inputSchema": {
    "type": "object",
    "required": ["points"],
    "properties": {
      "points": {"type": "array", "minItems": 1, "maxItems": 64, "items": {"type": "object", "required": ["x", "y", "z"]}},
      "laps": {"type": "integer", "minimum": 0},
      "pauseMs": {"type": "integer", "minimum": 0, "maximum": 600000}
    }
  },
  "roles": ["primary"],
  "messagesIn": ["stop", "focus", "policy"],
  "messagesOut": ["progress", "attention"],
  "capabilities": ["observe.*", "locomotion.moveTo"],
  "fallback": "pause-on-unknown-fault"
}
