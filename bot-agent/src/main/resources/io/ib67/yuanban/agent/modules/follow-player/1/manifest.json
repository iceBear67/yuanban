{
  "entry": "main",
  "description": "持续跟随名为 player 的玩家（保持 distance 格，默认 3），直到停止。focus/goal 消息的 payload.player 更换跟随对象；看不到玩家时用 attention(player_not_visible) 询问 supervisor。返回 {kind: stopped, player}。",
  "inputSchema": {
    "type": "object",
    "required": ["player"],
    "properties": {"player": {"type": "string", "minLength": 1, "maxLength": 16}, "distance": {"type": "number", "minimum": 1, "maximum": 16}}
  },
  "roles": ["primary"],
  "messagesIn": ["stop", "focus", "goal", "policy", "user_reply"],
  "messagesOut": ["progress", "attention"],
  "capabilities": ["observe.*", "locomotion.moveTo", "locomotion.lookAt"],
  "fallback": "pause-on-unknown-fault"
}
