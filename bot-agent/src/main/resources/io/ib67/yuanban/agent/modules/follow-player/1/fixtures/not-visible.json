{
  "name": "not-visible",
  "description": "看不到玩家：询问 supervisor；之后收到 focus 换成另一名可见的玩家",
  "input": {"player": "bob"},
  "world": {
    "entities": [{"id": 7, "type": "minecraft:player", "name": "alice", "position": {"x": 2.5, "y": 64, "z": 0.5}}]
  },
  "actions": [
    {"tool": "locomotion.lookAt", "outcome": "completed"},
    {"tool": "locomotion.lookAt", "outcome": "completed"},
    {"tool": "locomotion.lookAt", "outcome": "completed"},
    {"tool": "locomotion.lookAt", "outcome": "completed"},
    {"tool": "locomotion.lookAt", "outcome": "completed"}
  ],
  "inbox": [{"atMs": 300, "type": "focus", "payload": {"player": "alice"}}],
  "stopAtMs": 2500,
  "expect": {
    "status": "STOPPED",
    "result": {"kind": "stopped", "player": "alice"},
    "events": [{"type": "attention", "topic": "player_not_visible"}, {"type": "progress", "payload": {"step": "target_changed"}}],
    "toolCalls": ["observe.entities", "observe.entities", "locomotion.lookAt"],
    "noToolCalls": ["locomotion.moveTo"]
  }
}
