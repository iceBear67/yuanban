  "input": {"target": {"x": 10.5, "y": 64, "z": 0.5}},
  "actions": [
    {"tool": "locomotion.moveTo", "outcome": "completed", "delayMs": 5000}
  ],
  "stopAtMs": 300,
  "expect": {
