{
  "name": "damage",
  "description": "移动中受到伤害：发出 fault(hazard)；移动中位置持续变化，不发出 stalled",
  "asSupervisorOf": {
    "primary": "travel@1",
    "input": {"target": {"x": 10.5, "y": 64, "z": 0.5}, "watchdog": {"stallMs": 5000}}
  },
  "actions": [
    {"tool": "locomotion.moveTo", "outcome": "completed", "delayMs": 1200}
  ],
  "signals": [
    {"atMs": 200, "topic": "moved", "data": {"position": {"x": 2.5, "y": 64, "z": 0.5}, "onGround": true}},
    {"atMs": 400, "topic": "damage", "data": {"type": "minecraft:mob_attack", "sourceId": 7, "sourcePos": null}},
    {"atMs": 600, "topic": "moved", "data": {"position": {"x": 5.5, "y": 64, "z": 0.5}, "onGround": true}}
  ],
  "timeoutMs": 8000,
  "expect": {
    "status": "COMPLETED",
    "result": {"kind": "drained"},
    "events": [{"type": "fault", "topic": "hazard", "payload": {"reason": "damage"}}]
  }
}
