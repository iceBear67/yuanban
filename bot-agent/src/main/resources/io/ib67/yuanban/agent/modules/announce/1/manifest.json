{
  "entry": "main",
  "description": "在游戏中发送一条聊天消息 message（高风险，按策略可能被拒绝），带 idempotency key 防止重复发送。返回 {kind: sent|already_sent|denied|failed}；被拒绝时发出 attention(denied)。",
  "inputSchema": {
    "type": "object",
    "required": ["message"],
    "properties": {"message": {"type": "string", "minLength": 1, "maxLength": 256}, "idempotencyKey": {"type": "string", "maxLength": 128}}
  },
  "roles": ["primary"],
  "messagesIn": ["stop"],
  "messagesOut": ["progress", "attention", "fault"],
  "capabilities": ["observe.*", "external.chat"],
  "fallback": "stop-on-unknown-fault"
}
