{
  "name": "one-lap",
  "description": "两个路点巡逻一圈，第二个路点到不了时发出 attention",
  "input": {"points": [{"x": 5.5, "y": 64, "z": 0.5}, {"x": 5.5, "y": 64, "z": 5.5}], "laps": 1},
  "actions": [
    {"tool": "locomotion.moveTo", "match": {"target": {"z": 0.5}}, "outcome": "completed"},
    {"tool": "locomotion.moveTo", "match": {"target": {"z": 5.5}}, "outcome": "cancelled", "reason": "NO_PATH"}
  ],
  "expect": {
    "status": "COMPLETED",
    "result": {"kind": "completed", "laps": 1, "next": 0},
    "events": [
      {"type": "progress", "payload": {"step": "waypoint", "index": 0}},
      {"type": "attention", "topic": "unexpected_state", "payload": {"data": {"index": 1}}}
    ],
    "allActionsUsed": true
  }
}
