{
  "entry": "main",
  "description": "挖掉 pos 处的方块：读取方块，走到 3 格以内，带 idempotency key 挖掘，用 blockBroken observer 与 assertState 确认变成空气。返回 {kind: broken|not_broken|already_air|failed}；没有破坏时发出 attention(not_broken)。",
  "inputSchema": {
    "type": "object",
    "required": ["pos"],
    "properties": {
      "pos": {"type": "object", "required": ["x", "y", "z"]},
      "face": {"enum": ["DOWN", "UP", "NORTH", "SOUTH", "WEST", "EAST"]}
    }
  },
  "roles": ["primary"],
  "messagesIn": ["stop"],
  "messagesOut": ["progress", "attention", "fault"],
  "capabilities": ["observe.*", "locomotion.moveTo", "interaction.breakBlock"],
  "fallback": "pause-on-unknown-fault"
}
